---
interface Props {
  items: readonly { q: string; a: string }[];
  /** run-in: texto corrido · accordion: detalhes recolhidos */
  mode?: 'run-in' | 'accordion';
  class?: string;
}
const { items, mode = 'accordion', class: cls } = Astro.props;
---
{mode === 'run-in' ? (
  <div class:list={['faq', 'run-in', cls]}>
    {items.map((it, i) => <p data-reveal style={`--d:${i % 4}`}><strong>{it.q}</strong> {it.a}</p>)}
  </div>
) : (
  <div class:list={['faq', 'acc', cls]}>
    {items.map((it, i) => (
      <details data-reveal style={`--d:${i % 4}`}>
        <summary><span>{it.q}</span><i aria-hidden="true"></i></summary>
        <p>{it.a}</p>
      </details>
    ))}
  </div>
)}

<style>
  .run-in { display: grid; gap: 20px; }
  .run-in p { max-width: 62ch; line-height: 1.6; }
  .run-in strong { color: var(--azul); font-weight: 700; }
  .acc { display: grid; gap: 8px; }
  .acc details { background: var(--faq-bg, var(--cinza)); color: var(--faq-fg, var(--ink)); }
  .acc summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 20px;
    min-height: 64px; padding: 14px 20px; font-weight: 700; font-size: 1.125rem; line-height: 1.3;
  }
  .acc summary::-webkit-details-marker { display: none; }
  .acc summary i { position: relative; flex: none; width: 20px; height: 20px; }
  .acc summary i::before, .acc summary i::after { content: ''; position: absolute; left: 0; top: 8px; width: 20px; height: 4px; background: currentColor; transition: transform 0.25s var(--ease); }
  .acc summary i::after { transform: rotate(90deg); }
  .acc details[open] summary i::after { transform: rotate(0); }
  .acc details > p { padding: 0 20px 22px; max-width: 70ch; line-height: 1.6; }
</style>
