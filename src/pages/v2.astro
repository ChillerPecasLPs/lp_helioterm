---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import SpecTable from '../components/SpecTable.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import Pic from '../components/Pic.astro';
import { copy } from '../content/copy.v2';
import { defaultWhatsappUrl } from '../lib/whatsapp';
import { htc, HTC_MODELS } from '../lib/htc';

import fotoLateral from '../assets/photos/fabrica-chiller-lateral.jpg';
import fotoParede from '../assets/photos/chiller-parede.jpg';
import fotoAberto from '../assets/photos/chiller-aberto.jpg';
import dutadoSF from '../assets/renders/dutado-semfundo.png';
import portatilSF from '../assets/renders/portatil-semfundo.png';

const wa = defaultWhatsappUrl(copy);
const SCALE_MAX = 12000;
const bars = HTC_MODELS.map((m) => {
  const d = htc[m];
  return {
    name: m,
    min: d.capacidadeMin,
    max: d.capacidadeMax,
    left: (d.capacidadeMin / SCALE_MAX) * 100,
    width: ((d.capacidadeMax - d.capacidadeMin) / SCALE_MAX) * 100,
    label: d.values.capacidade,
  };
});
const ticks = [0, 3000, 6000, 9000, 12000];
const nf = new Intl.NumberFormat('pt-BR');
const products = [
  { ...copy.dehumidifiers.products.dutado, img: dutadoSF, alt: 'Render do desumidificador industrial dutado Helioterm, caixa azul-acinzentada com duas bocas de duto e display digital' },
  { ...copy.dehumidifiers.products.portatil, img: portatilSF, alt: 'Render do desumidificador industrial portátil Helioterm, gabinete preto e branco com serpentina na parte de cima' },
];
---
<BaseLayout title={copy.meta.title} description={copy.meta.description} variant={copy.variant} bodyClass="v2">
  <SiteHeader nav={copy.header.nav} cta={copy.header.whatsappCta} ctaHref={wa} tone="blue" ctaStyle="plain" />

  <main id="conteudo">
    <section class="hero on-dark" aria-labelledby="h1">
      <div class="wrap hero-grid">
        <h1 id="h1">Qual chiller a sua aplicação precisa?</h1>
        <p class="lead hero-lead" data-reveal>{copy.hero.subheadline}</p>
        <div class="hero-form" id="indicacao">
          <h2 class="card-title">{copy.heroForm.title}</h2>
          <LeadForm
            variant={copy.variant} id="form-hero-v2" fields={copy.heroForm.fields} submit={copy.heroForm.submit}
            success={copy.form.success} error={copy.form.error} privacyNote={copy.form.privacyNote} privacyHref={copy.form.privacyHref}
            order={['name', 'company', 'phone', 'application']} waMessage={copy.whatsapp.defaultMessage}
          />
          <p class="form-note">{copy.heroForm.note}</p>
          <p><a class="link-sub" href={wa} target="_blank" rel="noopener" data-wa data-wa-place="hero">{copy.hero.secondaryCta}<span class="sr-only"> (abre em nova aba)</span></a></p>
        </div>
        <ul class="ticks trust" data-reveal style="--d:1">
          {copy.hero.trust.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>

    <section id="checklist" class="check" aria-labelledby="ck-t">
      <div class="wrap two">
        <div>
          <h2 id="ck-t" data-reveal>{copy.checklist.title}</h2>
          <p class="lead" data-reveal style="--d:1">{copy.checklist.intro}</p>
        </div>
        <ul class="plain sheet-list">
          {copy.checklist.items.map((it, i) => (
            <li data-reveal style={`--d:${i}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" fill="currentColor" /><path d="M6 12.5l4 4 8-9" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="square" /></svg>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="selection" class="select on-dark" aria-labelledby="sel-t">
      <div class="wrap two">
        <div>
          <h2 id="sel-t" data-reveal>{copy.selection.title}</h2>
          <p class="lead" data-reveal style="--d:1">{copy.selection.text}</p>
          <ul class="plain pts">
            {copy.selection.points.map((p, i) => (<li data-reveal style={`--d:${i}`}><h3>{p.title}</h3><p>{p.text}</p></li>))}
          </ul>
        </div>
        <figure class="range" data-reveal>
          <figcaption>Faixa de capacidade frigorífica de cada modelo (kcal/h)</figcaption>
          <ul class="plain bars">
            {bars.map((b) => (
              <li>
                <span class="nm">{b.name}</span>
                <span class="track"><span class="fill" style={`left:${b.left}%;width:${b.width}%`}></span></span>
                <span class="val">{b.label} kcal/h</span>
              </li>
            ))}
          </ul>
          <div class="axis" aria-hidden="true">
            {ticks.map((t) => <span style={`left:${(t / SCALE_MAX) * 100}%`}>{nf.format(t)}</span>)}
          </div>
        </figure>
      </div>
    </section>

    <section id="chillers" class="chill" aria-labelledby="ch-t">
      <div class="wrap">
        <div class="ch-head two">
          <div>
            <h2 id="ch-t" data-reveal>{copy.chillers.title}</h2>
            <p class="lead" data-reveal style="--d:1">{copy.chillers.intro}</p>
            <ul class="plain benefits">
              {copy.chillers.benefits.map((b, i) => (<li data-reveal style={`--d:${i % 2}`}><h3>{b.title}</h3><p>{b.text}</p></li>))}
            </ul>
          </div>
          <figure class="ch-photo" data-reveal>
            <Pic src={fotoAberto} alt="Chiller Helioterm com o painel lateral aberto, mostrando a parte interna com compressor e tubulação" sizes="(min-width: 900px) 40vw, 100vw" widths={[480, 720, 960]} />
          </figure>
        </div>
        <SpecTable caption={copy.chillers.tableTitle} note={copy.chillers.tableNote} rows={['capacidade','compressor','cop','refrigerante','vazao','tensao','potenciaRegime','dimensoes','peso','conexoes']} />
        <p class="after"><a class="link-sub" href="#contato">{copy.chillers.cta}</a></p>
      </div>
    </section>

    <section id="aplicacoes" class="apps" aria-labelledby="ap-t">
      <div class="wrap two">
        <h2 id="ap-t" data-reveal>{copy.applications.title}</h2>
        <ul class="ticks cols" data-reveal style="--d:1">{copy.applications.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    </section>

    <section id="desumidificadores" class="dehum" aria-labelledby="dh-t">
      <div class="wrap">
        <h2 id="dh-t" data-reveal>{copy.dehumidifiers.title}</h2>
        <p class="lead" data-reveal style="--d:1">{copy.dehumidifiers.intro}</p>
        <div class="prods">
          {products.map((p, i) => (
            <article data-reveal style={`--d:${i}`}>
              <div class="tile"><Pic src={p.img} alt={p.alt} sizes="(min-width: 900px) 30vw, 70vw" widths={i === 0 ? [612] : [500]} /></div>
              <div>
                <h3>{p.name}</h3>
                <p>{p.tagline}</p>
                <ul class="ticks">{p.bullets.map((b) => <li>{b}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
        <div class="line" data-reveal>
          <h3>{copy.dehumidifiers.line.title}</h3>
          <p>{copy.dehumidifiers.line.text}</p>
          <p><a class="link-sub" href={wa} target="_blank" rel="noopener" data-wa data-wa-place="dehumidifiers">{copy.dehumidifiers.cta}<span class="sr-only"> (abre em nova aba)</span></a></p>
        </div>
      </div>
    </section>

    <section id="dimensionamento" class="sizing" aria-labelledby="sz-t">
      <div class="wrap two">
        <div>
          <h2 id="sz-t" data-reveal>{copy.sizing.title}</h2>
          <p class="lead" data-reveal style="--d:1">{copy.sizing.intro}</p>
          <figure class="sz-photo" data-reveal style="--d:2"><Pic src={fotoLateral} alt="Chiller compacto Helioterm instalado no piso de um galpão, visto de lado, com o painel de controle e a grade do condensador" sizes="(min-width: 900px) 36vw, 100vw" widths={[480, 720, 960]} /></figure>
        </div>
        <div>
          <ul class="ticks cols1" data-reveal>{copy.sizing.inputs.map((i) => <li>{i}</li>)}</ul>
          <p class="note" data-reveal>{copy.sizing.note}</p>
          <p data-reveal><a class="link-sub" href="#indicacao">{copy.sizing.cta}</a></p>
        </div>
      </div>
    </section>

    <section id="por-que" class="why" aria-labelledby="why-t">
      <div class="wrap two">
        <div>
          <h2 id="why-t" data-reveal>{copy.whyUs.title}</h2>
          <p class="lead" data-reveal style="--d:1">{copy.whyUs.intro}</p>
          <figure class="sz-photo" data-reveal style="--d:2"><Pic src={fotoParede} alt="Chiller Helioterm com logotipo no painel frontal, apoiado em rodízios junto a uma parede de blocos" sizes="(min-width: 900px) 36vw, 100vw" widths={[480, 720, 960]} /></figure>
        </div>
        <ul class="plain why-pts">
          {copy.whyUs.points.map((p, i) => (<li data-reveal style={`--d:${i % 2}`}><h3>{p.title}</h3><p>{p.text}</p></li>))}
        </ul>
      </div>
    </section>

    <section id="faq" class="faq-sec" aria-labelledby="faq-t">
      <div class="wrap two">
        <h2 id="faq-t" data-reveal>{copy.faq.title}</h2>
        <Faq items={copy.faq.items} mode="accordion" />
      </div>
    </section>

    <section id="contato" class="contact on-dark" aria-labelledby="ct-t">
      <div class="wrap two">
        <h2 id="ct-t" data-reveal class="wide">{copy.form.title}</h2>
        <div>
          <p class="lead" data-reveal style="--d:1">{copy.form.intro}</p>
          <p data-reveal style="--d:2"><a class="link-sub" href={wa} target="_blank" rel="noopener" data-wa data-wa-place="form">{copy.header.whatsappCta}<span class="sr-only"> (abre em nova aba)</span></a></p>
        </div>
        <div class="sheet" data-reveal style="--d:1">
          <LeadForm
            variant={copy.variant} id="form-v2" fields={copy.form.fields} submit={copy.form.submit}
            success={copy.form.success} error={copy.form.error} privacyNote={copy.form.privacyNote} privacyHref={copy.form.privacyHref}
            waMessage={copy.whatsapp.defaultMessage}
          />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter nav={copy.header.nav} footer={copy.footer} waHref={wa} waLabel={copy.header.whatsappCta} look="blue" />
  <WhatsAppFloat href={wa} label={copy.whatsapp.floatingLabel} />
</BaseLayout>

<style>
  section { padding-block: var(--section); }
  .two { display: grid; gap: 36px; align-items: start; }
  section h2 { color: var(--azul); }
  .on-dark h2 { color: var(--branco); }
  .lead { margin-top: 20px; }

  /* Hero: a pergunta é o layout; o formulário responde ao lado */
  .hero { background: var(--azul); padding-block: clamp(32px, 5vw, 80px) clamp(48px, 6vw, 96px); }
  .hero-grid { display: grid; gap: 28px; align-items: start; }
  .hero h1 { font-size: clamp(2rem, 9vw, 3.6rem); line-height: 1.06; color: var(--branco); }
  .hero-lead { color: var(--branco); max-width: 44ch; margin: 0; }
  .trust { color: var(--azul-pale); font-size: var(--step-small); font-weight: 700; }
  .hero-form { background: var(--branco); color: var(--ink); padding: clamp(20px, 2.6vw, 36px); display: grid; gap: 16px; --focus: var(--azul); }
  .on-dark .hero-form .card-title { font-size: 2rem; color: var(--azul); }
  .hero-form :global(.form-note), .hero-form .form-note { color: var(--ink-soft); }
  .hero-form .link-sub { color: var(--azul); }
  @media (min-width: 1000px) {
    .hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-rows: auto auto 1fr; gap: 28px 64px; }
    .hero h1 { grid-column: 1; grid-row: 1; font-size: clamp(2.5rem, 4.5vw, 5.2rem); }
    .hero-lead { grid-column: 1; grid-row: 2; }
    .trust { grid-column: 1; grid-row: 3; align-self: start; }
    .hero-form { grid-column: 2; grid-row: 1 / 4; }
  }

  /* Checklist */
  .check { background: var(--cinza); }
  .sheet-list { display: grid; gap: 10px; }
  .sheet-list li { display: flex; align-items: center; gap: 18px; background: var(--branco); padding: 18px 22px; font-weight: 700; font-size: var(--step-lead); line-height: 1.3; }
  .sheet-list svg { width: 28px; height: 28px; flex: none; color: var(--azul); }

  /* Seleção */
  .select { background: var(--ink-deep); }
  .select .lead { max-width: 56ch; }
  .pts { display: grid; gap: 20px; margin-top: 32px; }
  .pts h3 { color: var(--azul-claro); margin-bottom: 4px; }
  .range { display: grid; gap: 22px; padding-top: 8px; }
  .range figcaption { font-weight: 700; font-size: var(--step-lead); }
  .bars { display: grid; gap: 22px; }
  .bars li { display: grid; gap: 6px; }
  .nm { font-family: var(--font-display); font-size: 1.75rem; text-transform: uppercase; line-height: 1.1; }
  .track { display: block; position: relative; height: 28px; background: rgba(255, 255, 255, 0.12); }
  .fill { position: absolute; top: 0; bottom: 0; background: var(--azul-claro); transform-origin: left; }
  .val { font-weight: 700; }
  .axis { position: relative; height: 26px; margin-top: -8px; font-size: var(--step-small); color: var(--azul-pale); }
  .axis span { position: absolute; transform: translateX(-50%); }
  .axis span:first-child { transform: none; }
  .axis span:last-child { transform: translateX(-100%); }

  /* Chillers */
  .ch-head { margin-bottom: 48px; }
  .benefits { display: grid; gap: 22px; margin-top: 32px; }
  .benefits h3 { margin-bottom: 4px; }
  .ch-photo :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .after { margin-top: 16px; }
  .apps { background: var(--cinza); }
  .cols { columns: 1; }
  .cols li { break-inside: avoid; margin-bottom: 10px; }

  .dehum .prods { display: grid; gap: 32px; margin-top: 40px; }
  .dehum article { display: grid; gap: 18px; }
  .dehum .tile { background: var(--cinza); padding: 24px; display: grid; place-items: center; min-height: 260px; }
  .dehum .tile :global(img) { max-height: 240px; width: auto; }
  .dehum h3 { margin-bottom: 6px; }
  .dehum article p { margin-bottom: 12px; }
  .line { margin-top: 48px; background: var(--azul); color: var(--branco); padding: clamp(22px, 3vw, 40px); display: grid; gap: 12px; --focus: #fff; }
  .line p { max-width: 70ch; }

  .sizing { background: var(--cinza); }
  .sz-photo { margin-top: 32px; }
  .sz-photo :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .note { margin: 20px 0; max-width: 54ch; }
  .ticks.cols1 li { margin-bottom: 4px; }
  .why-pts { display: grid; gap: 24px; }
  .why-pts h3 { color: var(--azul); margin-bottom: 4px; }
  .faq-sec { background: var(--branco); }
  .contact { background: var(--azul); }
  .contact .lead { margin-top: 0; }
  .wide { grid-column: 1 / -1; }
  .sheet { background: var(--branco); color: var(--ink); padding: clamp(20px, 3vw, 40px); --focus: var(--azul); }
  .sheet :global(.form-note) { color: var(--ink-soft); }
  .sheet :global(.form-note a) { color: var(--azul); }

  @media (min-width: 900px) {
    .two { grid-template-columns: 5fr 7fr; gap: 80px; }
    .ch-head.two { grid-template-columns: 7fr 5fr; }
    .cols { columns: 3; column-gap: 40px; }
    .dehum .prods { grid-template-columns: 1fr 1fr; gap: 56px; }
    .why-pts { grid-template-columns: 1fr 1fr; gap: 32px 40px; }
  }
</style>
